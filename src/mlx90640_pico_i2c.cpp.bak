#include "config.h"
#include "hardware/i2c.h"
#include "pico/stdlib.h"
extern "C" {
#include "MLX90640_I2C_Driver.h"
}
alignas(4) static uint8_t rx[MLX90640_EEPROM_DUMP_NUM * 2u];
extern "C" void MLX90640_I2CInit() {
  i2c_init(MLX_I2C, MLX_I2C_HZ);
  gpio_set_function(MLX_SDA_PIN, GPIO_FUNC_I2C);
  gpio_set_function(MLX_SCL_PIN, GPIO_FUNC_I2C);
  gpio_pull_up(MLX_SDA_PIN);
  gpio_pull_up(MLX_SCL_PIN);
}
extern "C" void MLX90640_I2CFreqSet(int f) {
  if (f > 0)
    i2c_set_baudrate(MLX_I2C, (uint)f);
}
extern "C" int MLX90640_I2CRead(uint8_t a, uint16_t reg, uint16_t words,
                                uint16_t *d) {
  if (!d || !words || words > MLX90640_EEPROM_DUMP_NUM)
    return -1;
  uint8_t p[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
  if (i2c_write_blocking(MLX_I2C, a, p, 2, true) != 2)
    return -1;
  int bytes = words * 2;
  if (i2c_read_blocking(MLX_I2C, a, rx, bytes, false) != bytes)
    return -1;
  for (uint16_t i = 0; i < words; i++)
    d[i] = (uint16_t)((rx[2 * i] << 8) | rx[2 * i + 1]);
  return 0;
}
extern "C" int MLX90640_I2CWrite(uint8_t a, uint16_t reg, uint16_t v) {
  uint8_t p[4] = {(uint8_t)(reg >> 8), (uint8_t)reg, (uint8_t)(v >> 8),
                  (uint8_t)v};
  return i2c_write_blocking(MLX_I2C, a, p, 4, false) == 4 ? 0 : -1;
}
extern "C" int MLX90640_I2CGeneralReset() {
  uint8_t c = 6;
  int n = i2c_write_blocking(MLX_I2C, 0, &c, 1, false);
  sleep_ms(10);
  return n == 1 ? 0 : -1;
}
